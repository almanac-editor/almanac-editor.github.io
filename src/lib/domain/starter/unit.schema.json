{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Unit",
	"description": "Almanac's starter schema: the shape every unit needs. Replace or extend it to suit your school.",
	"type": "object",
	"required": ["unit_title", "subject", "description", "syllabus_registry", "lessons"],
	"properties": {
		"unit_title": {
			"type": "string",
			"minLength": 1
		},
		"subject": {
			"type": "string",
			"minLength": 1
		},
		"description": {
			"type": "string"
		},
		"applicable_outcomes": {
			"description": "Codes from the subject's outcome.json that this unit addresses.",
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1
			},
			"uniqueItems": true
		},
		"syllabus_registry": {
			"description": "The syllabus points the unit's lessons link to, by id.",
			"type": "array",
			"items": {
				"type": "object",
				"required": ["id", "framework", "phase", "text"],
				"properties": {
					"id": {
						"type": "string",
						"minLength": 1
					},
					"framework": {
						"type": "string",
						"minLength": 1
					},
					"phase": {
						"type": "string",
						"minLength": 1
					},
					"text": {
						"type": "string",
						"minLength": 1
					}
				}
			}
		},
		"assessments": {
			"description": "The unit's assessment tasks.",
			"type": "array",
			"items": {
				"type": "object",
				"required": ["title"],
				"properties": {
					"title": {
						"type": "string"
					},
					"assessment_type": {
						"type": "string"
					},
					"weight": {
						"description": "Percent of the course mark.",
						"type": "number",
						"minimum": 0
					},
					"description": {
						"type": "string"
					},
					"overview": {
						"type": "string"
					},
					"offerings": {
						"description": "Ids of the classes that sat it. Omit where every class taking the unit sits it.",
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1
						},
						"minItems": 1
					},
					"term": {
						"description": "For a class that took the unit in two parts, the term of the cohort that sat it.",
						"type": "string"
					},
					"class_minutes": {
						"description": "Class time given to working on the task and its feedback.",
						"type": "integer",
						"minimum": 0
					},
					"curriculum_links": {
						"description": "Dot points from syllabus_registry that the task itself evidences.",
						"type": "array",
						"items": {
							"type": "object",
							"required": ["framework", "id", "coverage", "mode"],
							"properties": {
								"framework": {
									"type": "string"
								},
								"id": {
									"type": "string"
								},
								"coverage": {
									"enum": ["full", "partial"]
								},
								"mode": {
									"enum": ["introduced", "developed", "consolidated", "revisited"]
								},
								"note": {
									"type": "string"
								}
							}
						}
					}
				}
			}
		},
		"lessons": {
			"description": "The unit's lesson plans, as paths relative to the unit, in teaching order.",
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "[.]json$"
			},
			"uniqueItems": true
		}
	}
}
